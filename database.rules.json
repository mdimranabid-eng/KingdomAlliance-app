{
  "rules": {
    "status": {
      "$uid": {
        ".write": "$uid === auth.uid",
        ".read": "auth !== null"
      }
    },
    "typingStatus": {
      "$chatId": {
        ".read": "auth !== null",
        "$uid": {
          ".write": "$uid === auth.uid",
          ".read": "auth !== null"
        }
      }
    },
    ".read": false,
    ".write": false
  }
}