rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isApproved() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (data.get('name', '') is string && data.get('name', '').size() <= 128) &&
             (data.get('profileType', 'bride') in ['bride', 'groom']) &&
             (data.get('aboutMe', '') is string && data.get('aboutMe', '').size() <= 2000) &&
             (data.get('denomination', '') is string && data.get('denomination', '').size() <= 100) &&
             (data.get('church', '') is string && data.get('church', '').size() <= 200) &&
             (data.get('education', '') is string && data.get('education', '').size() <= 200) &&
             (data.get('profession', '') is string && data.get('profession', '').size() <= 200) &&
             (data.get('location', '') is string && data.get('location', '').size() <= 200) &&
             (data.get('mobileNumber', '') is string && data.get('mobileNumber', '').size() <= 20) &&
             (data.get('emailVerified', false) is bool) &&
             (data.get('familyDetails', '') is string && data.get('familyDetails', '').size() <= 2000) &&
             (data.get('photoUrl', '') is string && data.get('photoUrl', '').size() <= 1000000) &&
             (data.get('pendingPhotoUrl', '') is string && data.get('pendingPhotoUrl', '').size() <= 1000000) &&
             (data.get('photoStatus', 'idle') in ['idle', 'pending', 'approved', 'rejected']) &&
             (data.get('photoPrivacy', 'public') in ['public', 'accepted_only']) &&
             (data.get('photoRejectionReason', '') is string && data.get('photoRejectionReason', '').size() <= 500) &&
             (data.get('approvalStatus', 'incomplete') in ['incomplete', 'pending', 'approved', 'rejected']) &&
             (data.get('onboardingComplete', false) is bool) &&
             ((data.get('age', 0) is int && data.get('age', 0) >= 18 && data.get('age', 0) <= 100) ||
             // Tolerate legacy docs where age was stored as a string (e.g. "25");
             // without this, isValidUser() fails and ALL owner updates are denied.
             (data.get('age', 0) is string && data.get('age', 0).size() > 0 && data.get('age', 0).size() <= 3)) &&
             (data.get('height', '') is string || data.get('height', 0) is int) &&
             (data.get('gender', '') in ['', 'male', 'female']) &&
             (data.get('gallery', []) is list);
    }

    function isValidInterest(data) {
      return data.fromId == request.auth.uid &&
             isValidId(data.toId) &&
             data.status in ['pending', 'accepted', 'declined'] &&
             data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 5000 &&
             data.createdAt == request.time &&
             (data.get('read', false) is bool) &&
             (data.get('receiverId', '') is string);
    }

    function isValidShortlist(data) {
      return data.userId == request.auth.uid &&
             isValidId(data.targetId) &&
             data.createdAt == request.time;
    }

    function isValidContactMessage(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 128 && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.mobile is string && data.mobile.size() == 10 && data.mobile.matches('^[0-9]+$') &&
             data.subject is string && data.subject.size() <= 100 &&
             data.message is string && data.message.size() <= 1000 &&
             data.status == 'new' &&
             data.createdAt == request.time;
    }

    // --- Collection Rules ---

    // Collection Group for unread counts
    match /{path=**}/messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.receiverId == request.auth.uid || isAdmin()) && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        isOwner(userId) || 
        isAdmin() || 
        (isApproved() && existing().isApproved == true &&
         // Profiles pending deletion are hidden from everyone except owner/admin
         existing().get('deletionStatus', '') != 'pending_deletion')
      );
      
      // List access: admins can list everything; regular members can only list
      // APPROVED profiles (prevents scraping of pending/unapproved data)
      allow list: if isAdmin() ||
        (isApproved() && resource.data.isApproved == true &&
         resource.data.get('deletionStatus', '') != 'pending_deletion');

      allow create: if isValidId(userId) && isOwner(userId) && incoming().uid == userId && incoming().email is string && incoming().createdAt == request.time;

      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && (
        // Owner Update
        // Photo moderation: owners upload new photos (photoStatus must become
        // 'pending') but can never flip photoApproved themselves - admin only.
        (isOwner(userId) && 
         !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isSuspended', 'isBanned', 'isApproved', 'status', 'approvalStatus', 'photoApproved']) &&
         // Locked fields — owners cannot change these after initial onboarding
         !incoming().diff(existing()).affectedKeys().hasAny([
           'denomination', 'churchName', 'diocese', 'baptized',
           'fathersName', 'fathersOccupation', 'mothersName', 'mothersOccupation',
           'numberOfSiblings', 'pastorNumber',
           'gender', 'dob', 'age', 'citizenship', 'maritalStatus',
           'profileFor', 'profileType', 'motherTongue', 'education'
         ]) &&
         incoming().uid == existing().uid &&
         incoming().email == existing().email &&
         incoming().createdAt == existing().createdAt &&
         ((!incoming().diff(existing()).affectedKeys().hasAny(['photoUrl', 'pendingPhotoUrl']) ||
           incoming().get('photoStatus', 'idle') == 'pending') ||
          // Gallery additions/removals are moderated via per-item status and
          // photoModeration docs, so they do not require flipping photoStatus.
          incoming().diff(existing()).affectedKeys().hasAny(['gallery']))
        ) ||
        // Admin Update
        (isAdmin() && 
         incoming().diff(existing()).affectedKeys().hasOnly(['isApproved', 'photoApproved', 'photoStatus', 'photoRejectionReason', 'photoUrl', 'pendingPhotoUrl', 'gallery', 'status', 'approvalStatus', 'updatedAt', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'rejectedReason', 'notifications', 'isSuspended', 'isBanned']) &&
         incoming().updatedAt == request.time
        )
      );
    }

    match /interests/{interestId} {
      allow get: if isValidId(interestId) && isSignedIn() && (
        isOwner(resource.data.fromId) || isOwner(resource.data.toId) || isAdmin()
      );
      
      allow list: if isSignedIn() && (
        resource.data.fromId == request.auth.uid || 
        resource.data.toId == request.auth.uid || 
        isAdmin()
      );
      
      allow create: if isValidId(interestId) && isSignedIn() && isValidInterest(incoming()) && 
                    isApproved() &&
                    exists(/databases/$(database)/documents/users/$(incoming().toId));

      allow update: if isValidId(interestId) && isSignedIn() && (
        (request.resource.data.status == 'accepted' && resource.data.toId == request.auth.uid && resource.data.status == 'pending') ||
        (request.resource.data.status == 'declined' && resource.data.toId == request.auth.uid && resource.data.status == 'pending') ||
        (request.resource.data.status == 'declined' && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid) && resource.data.status == 'accepted') ||
        (request.resource.data.status == 'accepted' && resource.data.declinedBy == request.auth.uid) ||
        isAdmin()
      );

      allow delete: if isValidId(interestId) && isSignedIn() && (
        (resource.data.fromId == request.auth.uid && resource.data.status == 'pending') ||
        isAdmin()
      );
    }

    match /shortlists/{shortlistId} {
      allow get: if isValidId(shortlistId) && isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(shortlistId) && isSignedIn() && isValidShortlist(incoming()) && isApproved();
      allow delete: if isValidId(shortlistId) && isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    match /profileViews/{viewId} {
      allow read, get, list: if isSignedIn() && (resource.data.profileId == request.auth.uid || resource.data.viewerId == request.auth.uid || isAdmin());
      allow create, update: if isValidId(viewId) && isSignedIn() && incoming().viewerId == request.auth.uid;
    }


    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid in chatId.split('_');
      }

      allow read, get, list: if isValidId(chatId) && isSignedIn() && (isParticipant() || isAdmin());
      allow delete: if isValidId(chatId) && isSignedIn() && (isParticipant() || isAdmin());
      
      match /messages/{messageId} {
        allow get: if isValidId(messageId) && isSignedIn() && (isParticipant() || isAdmin());
        allow list: if isSignedIn() && (isParticipant() || isAdmin());
        allow delete: if isValidId(messageId) && isSignedIn() && (isParticipant() || isAdmin());
        
        allow create: if isValidId(messageId) && isSignedIn() && isParticipant() && 
                      isValidMessage(incoming()) &&
                      incoming().chatId == chatId &&
                      get(/databases/$(database)/documents/interests/$(chatId)).data.status == 'accepted';
      }
    }

    match /photoModeration/{docId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.get('uid', resource.data.get('userId', '')) == request.auth.uid);
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (isAdmin() || existing().get('uid', existing().get('userId', '')) == request.auth.uid);
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (isOwner(adminId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow write: if isSignedIn() && request.auth.uid == adminId && request.auth.token.admin == true;
    }

    match /settings/{docId} {
      allow read: if docId == 'site_config';
      allow write: if isAdmin();
    }

    match /uploadedImages/{hashId} {
      allow read, create: if isSignedIn();
    }

    // OTPs are fully server-managed now (Cloud Functions in functions/src/otp.ts):
    // generated with crypto, stored hashed, attempt-limited. Clients must use the
    // requestOtp / verifyOtp callables. Direct client access is denied; the Admin
    // SDK bypasses these rules.
    match /temp_otps/{otpId} {
      allow read, write: if false;
    }

    // Email abuse-prevention log (written by Cloud Functions only)
    match /email_log/{logId} {
      allow read, write: if false;
    }

    match /churches/{churchId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /contact_messages/{messageId} {
      allow create: if isValidContactMessage(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().fromId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
