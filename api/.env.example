# ─── Server ─────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://your-domain.com
PUBLIC_BASE_URL=https://your-domain.com

# ─── MySQL (create in hPanel → Databases) ───────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_kaapp
DB_PASSWORD=your-strong-password
DB_NAME=u123456789_kaapp

# ─── Auth / JWT ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
OTP_HASH_SALT=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Email (SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending@gmail.com
SMTP_PASS=your-app-password
SUPPORT_EMAIL=support@kingdomalliance.com
SITE_NAME=The Kingdom Alliances

# ─── FCM (keep Firebase messaging only) ─────────────────
# Relative or absolute path to the service-account JSON (keep it OUT of git!)
FIREBASE_SERVICE_ACCOUNT_PATH=../server/serviceAccountKey.production.json

# ─── Captcha (Cloudflare Turnstile) ─────────────────────
TURNSTILE_SECRET_KEY=

# ─── Uploads ────────────────────────────────────────────
MAX_UPLOAD_MB=10

# ─── Admin bootstrap (first admin user) ─────────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
